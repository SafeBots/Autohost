[Unit]
Description=autohost cert renewal (daily)
Documentation=https://github.com/safebots/autohost

[Timer]
# Run daily at 03:17 with up to 1 hour of randomized delay so we don't
# stampede Let's Encrypt at exactly 03:17 from every box on Earth.
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
